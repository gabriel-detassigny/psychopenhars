{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/wordpress-7.1.3.zip",
	"phpVersion": "8.3",
	"testsEnvironment": false,
	"themes": [
		"https://downloads.wordpress.org/theme/twentytwentyfive.zip",
		"./theme/psychopenhars"
	],
	"mappings": {
		".htaccess": "./server/htaccess.example",
		"wp-content/uploads": "./local/uploads",
		"wp-content/psy-local": "./local",
		"wp-content/psy-content": "./content"
	},
	"config": {
